  "compilerActivity": "No compiler process before or after each invocation.",
  "benchmarkSource": "use openwebide_core::editor::{Document,Edit,Selection};\nuse std::{hint::black_box,time::Instant};\nfn main() {\n for (kind,unit) in [(\"ascii\",\"words VALUE 123; \"),(\"mixed\",\"\u6587\ud83d\ude00 words \")] {\n  let source=unit.repeat(1024*1024/unit.len());\n  let mut doc=Document::new(source.clone());\n  for _ in 0..5 { doc.apply(vec![Edit::replace(0..0,\"z\")],vec![Selection::caret(1)],None).unwrap();doc.undo(); }\n  for repeat in 0..3 {\n   let start=Instant::now();\n   for _ in 0..20 { doc.apply(vec![Edit::replace(0..0,\"z\")],vec![Selection::caret(1)],None).unwrap();doc.undo();black_box(doc.text()); }\n   let elapsed=start.elapsed().as_micros();\n   assert_eq!(doc.text(),source);\n   let at=source.floor_char_boundary(source.len()/2);\n   assert_eq!(doc.byte_to_textarea(at).unwrap(),source[..at].encode_utf16().count());\n   println!(\"{{\\\"kind\\\":\\\"{kind}\\\",\\\"bytes\\\":{},\\\"repeat\\\":{repeat},\\\"editUndoPairs\\\":20,\\\"microseconds\\\":{elapsed}}}\",source.len());\n  }\n }\n}\n",
  "limits": "Native document cost only, not browser viewport/startup/PSS or physical input performance."
}
