  "probeSource": "import runpy,json,pathlib,hashlib,sys,subprocess,os\nroot=pathlib.Path('/workspace/repos/openwebide');manifest=json.loads(pathlib.Path('/fixture/manifest.json').read_text());sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()\nassert {p.name:sha(p) for p in (root/'frontend/dist').glob('*.wasm')}==manifest['frontendWasmSha256']\nassert sha(root/'target/wasm32-wasip2/release/openwebide_backend.wasm')==manifest['backendWasmSha256']\nassert sha(root/'tools/measure-editor-view.py')==manifest['measurementScriptSha256']\nmodule=runpy.run_path(str(root/'tools/measure-editor-view.py'))\ndef embedded_source(case):\n size=int(case.rsplit('-',1)[1])*1024\n prefix,suffix=('```javascript\\n','```\\n')\n pattern='function run() {} // \u6587\ud83d\ude00 padding ................................\\n'\n return prefix+pattern*((size-len((prefix+suffix).encode()))//len(pattern.encode()))+suffix\nprobe=r'''\nwindow.editorTextVisibility=[];\ndocument.addEventListener('beforeinput', event=>{\n if(!event.target.matches('textarea[data-editor-path]'))return;\n const input=event.target,start=performance.now();let last;\n function observe(){\n  const code=input.parentElement,paint=code.querySelector('.editor-highlight-content');\n  const style=getComputedStyle(input),first=paint?.querySelector('.editor-source-line');\n  const record={nativeMarker:input.value.startsWith('z'),nativeBound:input.dataset.editorNativeBound,\n   nativeColor:style.color,nativeOpacity:style.opacity,highlightVisible:code.classList.contains('highlight-ready'),\n   paintMarker:first?.textContent.startsWith('z')??false,inputScope:input.dataset.editorScope,\n   paintScope:paint?.dataset.editorScope,paintVisibility:paint?getComputedStyle(paint).visibility:null};\n  const encoded=JSON.stringify(record);\n  if(encoded!==last){window.editorTextVisibility.push({atMs:performance.now()-start,...record});last=encoded;}\n  if(performance.now()-start<600)requestAnimationFrame(observe);\n }\n observe();requestAnimationFrame(observe);\n},true);\n'''\nBase=module['Browser']\nclass ObservedBrowser(Base):\n def call(self,method,path,payload=None,**kwargs):\n  if method=='POST' and path=='/url':\n   super().call('POST','/goog/cdp/execute',{'cmd':'Page.addScriptToEvaluateOnNewDocument','params':{'source':probe}})\n  return super().call(method,path,payload,**kwargs)\n def script(self,script,*args,**kwargs):\n  if script.startswith('return {...window.editorViewMeasurement,'):\n   script=script.replace('return {','return {textVisibility:window.editorTextVisibility,',1)\n  result=super().script(script,*args,**kwargs)\n  if isinstance(result,dict) and 'textVisibility' in result: print(json.dumps({'visibilityMode':sys.argv[1],'textVisibility':result['textVisibility']}),flush=True)\n  return result\nmodule['measure'].__globals__['Browser']=ObservedBrowser\nmodule['measure'].__globals__['source_for']=embedded_source\nmode=sys.argv[1];repetition=int(sys.argv[3]);case=sys.argv[5]\nresult=module['measure'](case,mode,False,False,repetition,'beginning',False,'measure.md')\nassert result['completeSourceAfterInputVerified'] is True\nassert result['peakChromePssKiB'] is not None\nprint(json.dumps({'cohort':'embedded-markdown-visible-text','runtime':manifest,**result}),flush=True)\n",
  "probeSha256": "0097df0a8834381d9b78eb4c1183240c91ec6d00327183fc5e86d0c64a88fcd7"
